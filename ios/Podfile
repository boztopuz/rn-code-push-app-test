# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.5'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RNCodepushTest' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'CodePush', :path => '../node_modules/@appcircle/react-native-code-push'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Fix fmt consteval compilation error - apply to ALL targets
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        existing = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        unless existing.include?('-DFMT_CONSTEVAL=constexpr')
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = existing + ['-DFMT_CONSTEVAL=constexpr']
        end

        existing_c = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        unless existing_c.include?('FMT_CONSTEVAL=constexpr')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing_c + ['FMT_CONSTEVAL=constexpr']
        end
      end
    end
  end
end
